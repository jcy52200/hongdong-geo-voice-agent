# Node.js 24+; copy to .env, then fill your own key (never commit it).
SEED_API_KEY=
# Optional: required only when enabling built-in web search in model settings.
SEED_WEBSEARCH_API_KEY=
# DeepSeek V4.1 Flash: official API model alias is deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3000
# Default: ./data/geo.sqlite
# GEO_DATABASE_PATH=./data/geo.sqlite
# GEO_RECORDINGS_PATH=./data/recordings
