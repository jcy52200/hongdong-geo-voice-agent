# Node.js 24+; copy to .env, then fill your own key (never commit it).
SEED_API_KEY=
# Optional: required only when enabling built-in web search in model settings.
SEED_WEBSEARCH_API_KEY=
# DeepSeek V4.1 Flash: official API model alias is deepseek-flash.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
PORT=3000
# Default: ./data/geo.sqlite
# GEO_DATABASE_PATH=./data/geo.sqlite
# GEO_RECORDINGS_PATH=./data/recordings

# Manual telephone pilot only. SIP credentials are NOT CCC RAM API credentials.
# All values below are placeholders. Store real credentials only in private .env.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional, required with STS temporary AccessKey credentials.
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_CCC_REGION_ID=cn-shanghai
ALIYUN_CCC_ENDPOINT=ccc.cn-shanghai.aliyuncs.com
ALIYUN_CCC_INSTANCE_ID=
# Full CCC agent ID, e.g. agent@instance; never use a SIP extension here.
ALIYUN_CCC_USER_ID=
# Exact Number returned by ListOutboundNumbersOfUser; do not rewrite 669 demo numbers.
ALIYUN_CCC_CALLER=
ALIYUN_CCC_DEVICE_ID=hongdong-pilot
ALIYUN_CCC_TIMEOUT_MS=10000
# The one approved test mobile; it must be in the demo whitelist when using a demo instance.
PILOT_TEST_PHONE=

# Dedicated CCC SIP terminal. Confirm registrar/domain/TLS port with this instance's console/support.
ALIYUN_SIP_EXTENSION=
ALIYUN_SIP_AUTH_USER=
ALIYUN_SIP_PASSWORD=
ALIYUN_SIP_DOMAIN=
# Bare sip:hostname:port or sips:hostname:port, no ;transport=tls suffix.
ALIYUN_SIP_REGISTRAR_URI=
# Comma-separated exact provider signaling CIDRs; no catch-all network.
ALIYUN_SIP_SOURCE_CIDRS=

# Node <-> SIPhon control, private loopback. Generate an independent random token of >=32 characters.
SIPHON_CONTROL_URL=ws://127.0.0.1:9092/control/ws
SIPHON_CONTROL_TOKEN=
# The media listener stays on loopback; native Node + host-network engine share the ECS host.
PILOT_MEDIA_PORT=3001
PILOT_MEDIA_BASE_URL=ws://127.0.0.1:3001
# Host-side gateway recording directory, MUST equal SIPHON_RECORDING_DIR after resolution.
PILOT_GATEWAY_RECORDINGS_PATH=./data/gateway-recordings
# Engine-container path, mapped from the host-side directory; not a host filesystem path.
SIPHON_RECORDINGS_PATH=/recordings

# Linux ECS deployment (compose.ecs.example.yml and start-sip.sh).
ECS_PRIVATE_IP=
ECS_PUBLIC_IP=
SIPHON_ADVERTISED_HOST=
# Loopback default; set the actual private interface explicitly for authorized provider ingress.
SIPHON_SIP_BIND_IP=127.0.0.1
SIPHON_SIP_PORT=5061
SIPHON_TLS_CERT_FILE=
SIPHON_TLS_KEY_FILE=
# Absolute server path to this repository's deploy/siphon/route.py.
SIPHON_ROUTE_FILE=
# Optional: path to a private copy of siphon.yaml.example.
SIPHON_CONFIG_FILE=
# Independent >=32-character secret, identical to the contents of the mounted secret file.
SIPHON_RTP_CONTROL_SECRET=
SIPHON_RTP_CONTROL_SECRET_FILE=
# Absolute ECS directory, shared with PILOT_GATEWAY_RECORDINGS_PATH above.
SIPHON_RECORDING_DIR=

# Optional synthetic-loopback verifier overrides (no CCC/SIP registration or real calling).
# SIPHON_VERIFY_CONTROL_PORT=8080
# SIPHON_VERIFY_RECORDING_DIR=/recordings
