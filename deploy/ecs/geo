#!/bin/bash
set -euo pipefail
cd /opt/hongdong-geo/current
export PATH=/opt/hongdong-geo/runtime/node-v24.14.1-linux-x64/bin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
node=/opt/hongdong-geo/runtime/node-v24.14.1-linux-x64/bin/node
envfile=/etc/hongdong-geo/voice.env
command=${1:-help}
if (($#)); then shift; fi
case "$command" in
  doctor)
    exec setpriv --reuid hongdong --regid hongdong --init-groups "$node" --env-file="$envfile" --import tsx server/trunk-pilot.ts doctor "$@"
    ;;
  pilot)
    # One backend owns the same SQLite file. The caller explicitly passes --dial.
    systemctl stop hongdong-workbench.service
    trap 'systemctl start hongdong-workbench.service' EXIT
    setpriv --reuid hongdong --regid hongdong --init-groups "$node" --env-file="$envfile" --import tsx server/trunk-pilot.ts call "$@"
    ;;
  status)
    systemctl --no-pager --full status hongdong-workbench hongdong-sip hongdong-media
    ;;
  *)
    echo 'geo doctor [--online] | geo pilot --dial --sample | geo pilot --dial --customer UUID | geo status'
    ;;
esac
