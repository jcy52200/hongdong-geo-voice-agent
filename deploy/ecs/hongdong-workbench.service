[Unit]
Description=Hongdong GEO local workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hongdong
Group=hongdong
WorkingDirectory=/opt/hongdong-geo/current
EnvironmentFile=/etc/hongdong-geo/voice.env
Environment=PATH=/opt/hongdong-geo/runtime/node-v24.14.1-linux-x64/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/hongdong-geo/runtime/node-v24.14.1-linux-x64/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hongdong-geo
MemoryMax=256M
CPUWeight=50

[Install]
WantedBy=multi-user.target
